{
  "$defs": {
    "AudioInfo": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "ogg_opus",
                "wav"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "none",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "AudioInfo",
      "type": "object"
    },
    "Latency": {
      "additionalProperties": false,
      "properties": {
        "measured": {
          "const": "server",
          "default": "server",
          "title": "Measured",
          "type": "string"
        },
        "median_reply_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Reply Ms"
        },
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        },
        "p90_reply_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90 Reply Ms"
        },
        "resumes": {
          "default": 0,
          "title": "Resumes",
          "type": "integer"
        }
      },
      "title": "Latency",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "main",
            "follow_up",
            "greeting",
            "closing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question Id"
        },
        "speaker": {
          "enum": [
            "interviewer",
            "candidate"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text",
        "start_ms",
        "end_ms",
        "question_id",
        "kind"
      ],
      "title": "Turn",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_write_tokens": {
          "default": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "characters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Characters"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "kind": {
          "default": "llm",
          "enum": [
            "llm",
            "stt",
            "tts"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audio": {
      "$ref": "#/$defs/AudioInfo"
    },
    "end_reason": {
      "enum": [
        "completed",
        "time_limit",
        "budget",
        "ended_by_candidate",
        "disconnected",
        "error"
      ],
      "title": "End Reason",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "latency": {
      "$ref": "#/$defs/Latency"
    },
    "llm_cost_usd": {
      "title": "Llm Cost Usd",
      "type": "number"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Turns",
      "type": "array"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/Usage"
      },
      "title": "Usage",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "end_reason",
    "error",
    "started_at",
    "ended_at",
    "turns",
    "usage",
    "llm_cost_usd",
    "audio",
    "latency"
  ],
  "title": "Result",
  "type": "object"
}
